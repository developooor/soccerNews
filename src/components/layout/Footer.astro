  <div class="container newsletter-inner">
    <div>
      <span class="eyebrow">THE WEEKLY KICKOFF</span>
      <h2>
        The game moves fast.
        <br />
        Stay in the conversation.
      </h2>
      <p>
        Our newsletter is coming soon. This demo does not collect email
        addresses.
      </p>
    </div>
    <button class="button" disabled>
      Coming soon <ArrowRight size={18} />
    </button>
  </div>
</section>
<footer class="container">
  <div class="footer-top">
    <a class="footer-brand" href="/">
      SOCCER USA NEWS<span>A wider perspective on the American game.</span>
    </a>
    <nav aria-label="Footer navigation">
      <a href="/mls/">MLS</a>
      <a href="/usmnt/">USMNT</a>
      <a href="/guides/">Soccer guides</a>
      <a href="/mls/schedule/">Match center</a>
    </nav>
  </div>
  <div class="footer-bottom">
    <span>© 2026 Soccer USA News · Frontend demonstration</span>
    <span>All simulated sports content is demo data.</span>
