---
import Base from "./BaseLayout.astro";
import Bread from "../components/layout/Breadcrumbs.astro";
import News from "../components/news/NewsSection.astro";
import { getArticlesByCategory } from "../lib/api";
import type { Article } from "../types/models";
interface Props {
  article: Article;
}
const { article: a } = Astro.props;
const related = (await getArticlesByCategory(a.category))
  .filter((x) => x.id !== a.id)
  .slice(0, 3);
const sectionUrl =
  a.category === "MLS"
    ? "/mls/"
    : a.category === "USMNT"
      ? "/usmnt/"
      : "/guides/";
const url = new URL(Astro.url.pathname, Astro.site).href;
const format = (date: string) =>
  new Date(date).toLocaleDateString("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  });
const schema = [
  {
    "@context": "https://schema.org",
    "@type": a.category === "Guides" ? "Article" : "NewsArticle",
    headline: a.title,
    description: a.excerpt,
    datePublished: a.publishedAt,
    ...(a.updatedAt ? { dateModified: a.updatedAt } : {}),
    author: { "@type": "Organization", name: a.author },
    image: new URL(a.image, Astro.site).href,
    mainEntityOfPage: url,
    publisher: { "@type": "Organization", name: "Soccer USA News" },
    articleBody: [a.intro, ...a.sections.map((s) => s.text)].join("\n"),
  },
];
---

<Base title={a.title} description={a.excerpt} schema={schema}>
  <Bread
    items={[{ label: a.category, href: sectionUrl }, { label: a.title }]}
  />
  <article class="article-detail">
    <header class="article-header">
      <span class="eyebrow">{a.category} · DEMO EDITORIAL</span>
      <h1>{a.title}</h1>
      <p class="article-deck">{a.excerpt}</p>
      <div class="article-meta">
        <strong>By {a.author}</strong>
        <span>
          <time datetime={a.publishedAt}>
            {format(a.publishedAt)} · 12:00 UTC
          </time>{" "}
          · {a.readingTime} min read
        </span>
        {a.updatedAt && (
          <span>
            Updated{" "}
            <time datetime={a.updatedAt}>
              {format(a.updatedAt)} · 14:00 UTC
            </time>
          </span>
        )}
      </div>
    </header>
    <figure>
      <img
        src={a.image}
        alt={a.imageAlt}
        width="1400"
        height="900"
        fetchpriority="high"
      />
      <figcaption>
        Original illustration · No real match is depicted.
      </figcaption>
    </figure>
    <div class="article-columns">
      <aside class="article-aside">
        <h2>In this story</h2>
        <nav aria-label="Table of contents">
          {a.sections.map((s) => (
            <a href={`#${s.id}`}>{s.heading}</a>
          ))}
        </nav>
        <h2>Share this demo</h2>
        <a
          target="_blank"
          rel="noopener noreferrer"
          href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`}
        >
          Facebook →
        </a>
        <a
          target="_blank"
          rel="noopener noreferrer"
          href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(a.title + " (demo story)")}`}
        >
          X / Twitter →
        </a>
      </aside>
      <div class="article-prose">
        <div class="content-notice">
          <strong>Demo content</strong> · This article is a fictional sample.
          Events, dates and scenarios are not news reports.
        </div>
        <p class="intro">{a.intro}</p>
        {a.sections.map((s) => (
          <section id={s.id}>
            <h2>{s.heading}</h2>
            <p>{s.text}</p>
            {s.subheading && (
              <>
                <h3>{s.subheading}</h3>
                <p>{s.detail}</p>
              </>
            )}
          </section>
        ))}
        <section>
          <h2>Sources & further reading</h2>
          <p>
            The sources below provide official background information. They do
            not substantiate the fictional scenarios in this sample.
          </p>
          <ul>
            {a.sources.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener noreferrer">
                  {s.label} →
                </a>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </div>
  </article>
  <News title="Keep reading" articles={related} />
</Base>
